# Neon Postgres. Use the POOLED connection string for DATABASE_URL
# and the DIRECT (non pooled) one for DIRECT_URL.
DATABASE_URL="postgresql://user:pass@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# https://app.tavily.com  (free tier: 1,000 credits a month)
TAVILY_API_KEY="tvly-xxxxxxxx"

# Google Cloud console, YouTube Data API v3 (free: 10,000 units a day)
YOUTUBE_API_KEY="AIzaSyxxxxxxxx"

# Any long random string. Needed to add or remove channels and to trigger a
# manual sync. Generate one with: openssl rand -hex 24
ADMIN_KEY="change-me"

# Optional quota tuning (defaults shown)
# Tavily searches per sync run. 2 runs a day x 30 days x 16 = 960 credits/month.
TAVILY_QUERIES_PER_SYNC=16
# Results requested per Tavily search (max 20, same 1 credit either way).
TAVILY_MAX_RESULTS=20
# Locations searched on EVERY run before the rotation, e.g. your home district.
# Format: comma separated location ids, see src/lib/locations.ts
# Leave unset to use the built in default (Gurugram, Chandauli, Varanasi).
# PRIORITY_LOCATIONS="district:haryana:gurugram,district:uttar-pradesh:chandauli,district:uttar-pradesh:varanasi"
# Safety cap on YouTube channel lookups (100 units each) per UTC day.
MAX_CHANNEL_SEARCHES_PER_DAY=20
# Delete feed items older than this many days.
RETENTION_DAYS=30
